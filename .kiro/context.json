{
  "exclude": [
    "**/__pycache__/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/staticfiles/**",
    "**/*.pyc",
    "**/logs/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/htmlcov/**",
    "**/*.egg-info/**",
    "**/dist/**",
    "**/build/**",
    "**/.coverage",
    "**/coverage.xml"
  ],
  "maxFileSize": "100KB",
  "autoInclude": [
    "app/**/*.py",
    "tests/**/*.py",
    "docs/**/*.md",
    ".kiro/steering/**/*.md",
    "pyproject.toml",
    "docker-compose.yml",
    "Dockerfile",
    "nginx.conf",
    ".env.example"
  ]
}
