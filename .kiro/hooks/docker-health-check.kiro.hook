{
  "enabled": true,
  "name": "Docker Health Check",
  "description": "Suggests verifying Docker services are healthy when Docker configuration files are modified",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "docker-compose.yml",
      "Dockerfile",
      ".devcontainer/*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Docker configuration was modified. Suggest running `docker compose ps` to check service health and `docker compose logs` if any services are unhealthy. Remind to rebuild with `docker compose up -d --build` if needed per deployment guidelines."
  }
}