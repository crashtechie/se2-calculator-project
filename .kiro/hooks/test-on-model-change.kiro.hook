{
  "enabled": true,
  "name": "Test on Model Change",
  "description": "Suggests running tests for the specific app when model files are modified",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "app/*/models.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A model file was changed. Suggest running tests for this specific app using `uv run pytest app/{app_name}/tests/ -v` where {app_name} is extracted from the file path. Remind about the >80% coverage requirement."
  }
}