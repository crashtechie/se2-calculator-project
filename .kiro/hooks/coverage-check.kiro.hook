{
  "enabled": true,
  "name": "Coverage Check on Test Changes",
  "description": "Checks test coverage when test files are modified to ensure >80% coverage requirement",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "app/*/test*.py",
      "app/*/tests/*.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Test files were modified. Suggest running `uv run pytest --cov --cov-report=term-missing` to check coverage. Ensure coverage is above 80% per project standards and report any uncovered lines."
  }
}